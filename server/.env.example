# Copy this file to .env and fill it in. Never commit .env.

# Supabase dashboard > Project Settings > API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
# The "secret" key (older projects call it "service_role"). Server only: never put it in the app.
SUPABASE_SECRET_KEY=

# Encrypts connected-account tokens in the database. Generate with: npm run gen-key
# If you lose or change this, every connected account has to be reconnected.
TOKEN_ENCRYPTION_KEY=

PORT=8787
SYNC_INTERVAL_MINUTES=15
